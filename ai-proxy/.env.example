# AI Proxy configuration. Never commit real credentials.

# Runtime
PORT=3001
NODE_ENV=development

# Production must contain exact browser origins, never "*". Origins do not
# include paths; a GitHub Pages project is still https://OWNER.github.io.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Google external HTTP(S) load balancing appends client IP and load-balancer IP,
# so Cloud Run uses two trusted hops. Re-verify the chain for another platform;
# never trust an arbitrary left-most X-Forwarded-For value.
TRUST_PROXY_HOPS=2

# Request and context bounds
MAX_JSON_BYTES=131072
MAX_CONTEXT_BYTES=98304
MAX_CONTEXT_DEPTH=12
MAX_CONTEXT_NODES=5000
MAX_CONTEXT_STRING_BYTES=32768
ALLOWED_AI_MODELS=minimax,openai,deepseek,grok,gemini,gemma,claude

# Only these models may use owner-held provider keys. Other models require BYOK.
SERVER_KEY_MODELS=minimax

# Anonymous signed session + proof-of-work challenge. This is not account
# identity and it is not a distributed/global quota, but it is stronger than a
# naked public endpoint. Production defaults REQUIRE_ANON_SESSION to true.
REQUIRE_ANON_SESSION=true
ANON_SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_POW_DIFFICULTY=14
SESSION_CHALLENGE_TTL_SECONDS=120
SESSION_TTL_SECONDS=86400
SESSION_CHALLENGE_REQUESTS_PER_MINUTE=10

# Per-instance weighted limits. A story costs 3 points; selected expensive text
# tasks cost 2; ordinary tasks cost 1; image generation costs 16.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_SESSION_POINTS=24
RATE_LIMIT_IP_POINTS=48
MAX_CONCURRENT_AI_REQUESTS=4

# Image generation is expensive and is disabled unless explicitly enabled.
ENABLE_IMAGE_GENERATION=false

# Per-instance circuit breakers. Zero disables a dimension. Estimates reserve
# budget before a provider call and are intentionally conservative.
INSTANCE_MAX_REQUESTS_PER_HOUR=300
INSTANCE_MAX_REQUESTS_PER_DAY=3000
INSTANCE_MAX_ESTIMATED_USD_PER_HOUR=5
INSTANCE_MAX_ESTIMATED_USD_PER_DAY=25
ESTIMATED_STORY_REQUEST_USD=0.012
ESTIMATED_HIGH_TASK_USD=0.008
ESTIMATED_MEDIUM_TASK_USD=0.005
ESTIMATED_DEFAULT_TASK_USD=0.003
ESTIMATED_IMAGE_REQUEST_USD=0.08
ESTIMATED_BYOK_REQUEST_USD=0

# IMPORTANT: in-memory limits reset on restart and can be multiplied by
# autoscaling. Set provider-side hard daily/monthly budgets, billing alerts,
# Cloud Run max instances, and platform spend limits as the real final backstop.

# Provider keys
MINIMAX_API_KEY=your-minimax-key-here
# OPENAI_API_KEY=only-if-owner-funded-openai-is-explicitly-intended
# DEEPSEEK_API_KEY=only-if-owner-funded-deepseek-is-explicitly-intended
# GROK_API_KEY=only-if-owner-funded-grok-is-explicitly-intended
# GOOGLE_API_KEY=only-if-owner-funded-google-models-are-explicitly-intended
# ANTHROPIC_API_KEY=only-if-owner-funded-claude-is-explicitly-intended

# Optional legacy memory service (currently recommended disabled/removed).
# MEMPALACE_URL=http://localhost:8200
